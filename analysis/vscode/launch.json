        "order": 2
      }
    },
    {
      "name": "VS Code 混合调试 (Linux - 当前文件)",
      "configurations": [
        "C++ 调试 (Linux/Windows - 当前文件)",
        "VS Code 内部混合调试 (当前文件)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "Mixed Debugging",
        "order": 3
      }
    },
    {
      "name": "VS Code 混合调试 (Linux - 指定文件)",
      "configurations": [
        "C++ 调试 (Linux/Windows - 指定文件)",
